[Unit]
Description=KVMaestro Node Agent
After=network-online.target libvirtd.service
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/wvc-agent --config /etc/wvc-agent/config.yaml
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

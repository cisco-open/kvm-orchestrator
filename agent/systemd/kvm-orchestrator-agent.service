[Unit]
Description=KVM Orchestrator Node Agent
After=network-online.target libvirtd.service
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/kvm-orchestrator-agent --config /etc/kvm-orchestrator-agent/config.yaml
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
